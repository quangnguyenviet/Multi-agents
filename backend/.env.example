# LLM Configuration
# Option 1: Groq (public cloud)
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Option 2: 9Router (internal proxy)
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=http://<host>:<port>/v1
# LLM_MODEL=evotek_flash

# Skills: nguồn lưu trữ là MinIO (bucket chứa các file .md). API read-only, refresh theo TTL.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_SKILLS=skills
SKILLS_CACHE_TTL=300

# Storage backend — dev để mặc định (SQLite + in-memory).
# Production: đặt DB_BACKEND=postgres + DATABASE_URL, và REDIS_URL để dùng Redis cho blob tạm.
DB_BACKEND=sqlite
# DATABASE_URL=postgresql://evo:evo@localhost:5432/evo
# REDIS_URL=redis://localhost:6379/0
BLOB_TTL=3600
